{
	"name": "script-manager",
	"displayName": "Script Manager",
	"publisher": "HugeLetters",
	"type": "commonjs",
	"description": "",
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.105.0"
	},
	"categories": [
		"Other"
	],
	"repository": {
		"url": "https://github.com/HugeLetters/script-manager"
	},
	"main": "./dist/index.js",
	"scripts": {
		"build": "bun run src/scripts/run/build.ts",
		"release": "bun run src/scripts/run/release.ts",
		"dev": "bun run build --watch --release",
		"package": "vsce package --no-dependencies",
		"format": "biome check --write .",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"check": "bun run typecheck && bun run lint",
		"prepare": "effect-language-service patch"
	},
	"dependencies": {
		"@effect/platform-node": "4.1.0",
		"effect": "4.1.0",
		"simple-git": "^3.30.0",
		"ts-morph": "^27.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@effect/language-service": "0.87.5",
		"@effect/platform-bun": "4.1.0",
		"@types/bun": "^1.3.3",
		"@types/node": "^22",
		"@types/vscode": "^1.105.0",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.25.10",
		"typescript": "^5.9.3"
	},
	"contributes": {
		"menus": {
			"editor/title/context": [
				{
					"command": "script-manager.rename-tab",
					"when": "resourceScheme == file",
					"group": "navigation"
				}
			]
		},
		"commands": [
			{
				"command": "script-manager.insert-todo-comment",
				"title": "Todo Comment"
			},
			{
				"command": "script-manager.rename-tab",
				"title": "Rename Tab"
			}
		]
	},
	"activationEvents": [
		"onLanguage:javascript",
		"onLanguage:javascriptreact",
		"onLanguage:typescript",
		"onLanguage:typescriptreact"
	]
}
